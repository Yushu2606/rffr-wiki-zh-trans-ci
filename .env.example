# ====== Wiki 抓取 ======
WIKI_API_URL=https://YOUR-TARGET-WIKI.fandom.com/api.php
WIKI_SOURCE_LANG=en
WIKI_TARGET_LANG=zh
# 命名空间（逗号分隔）：0=主条目 10=模板 14=分类 828=Lua模块；
# 模板会走 LLM 翻译，Lua模块/CSS/JS 会原样复制
WIKI_NAMESPACES=0,10,14,828
WIKI_CATEGORY=
WIKI_PAGE_LIST=
WIKI_ALL_PAGES=true
WIKI_FILTER_REDIRECTS=nonredirects
WIKI_MAX_PAGES=0
WIKI_SLEEP_BETWEEN=0.3
WIKI_USER_AGENT=WikiTranslateBot/1.0 (github actions; contact: your-github-username)

# ====== LLM ======
TRANSLATOR_PROVIDER=openai
TRANSLATOR_BASE_URL=https://api.openai.com/v1
TRANSLATOR_MODEL=gpt-4o-mini
TRANSLATOR_TEMPERATURE=0
TRANSLATOR_MAX_TOKENS=4096
TRANSLATOR_CHUNK_CHARS=3500
TRANSLATOR_RETRY=3
TRANSLATOR_RETRY_DELAY=5
TRANSLATOR_SYSTEM_PROMPT_FILE=prompts/system.txt
# 术语表 CSV，格式：en,zh,note；空 zh 表示强制保持原样
TRANSLATOR_GLOSSARY_FILE=prompts/glossary.csv
# 单次 prompt 最多注入多少条术语
TRANSLATOR_GLOSSARY_MAX_ENTRIES=50
# process 阶段进程内并发数（线程池）：翻译是网络 I/O 瓶颈，>1 能显著提速；
# 注意别超过 LLM 接口的速率限制，建议从 3-5 试起
TRANSLATOR_CONCURRENCY=1

# ====== 输出 ======
OUTPUT_DIR=output
OUTPUT_STATE_FILE=state.json
OUTPUT_COMMIT_MESSAGE=chore(i18n): auto-translate wiki pages

# ====== 推送回目标 wiki（默认关闭） ======
PUBLISH_ENABLED=false
PUBLISH_API_URL=https://YOUR-TARGET-WIKI.fandom.com/zh/api.php
PUBLISH_SUMMARY=AI 自动翻译同步 (github actions)
PUBLISH_BOT_FLAG=true
PUBLISH_MINOR=false
PUBLISH_SLEEP_BETWEEN=3.0
PUBLISH_RETRY=3
PUBLISH_RETRY_DELAY=5
PUBLISH_TITLE_PREFIX=
PUBLISH_TITLE_SUFFIX=
PUBLISH_TITLE_MAP={}
# 目标 wiki 被人改过时的策略：
#   skip      = 默认，跳过推送，需 --force 覆盖
#   overwrite = 直接覆盖
#   merge     = 调用 LLM 三方合并（仓库译文 + 目标当前 + 上次源缓存）后推送
PUBLISH_ON_TARGET_CONFLICT=skip
# 文件分块上传：超过该 MB 阈值的文件自动改用分块上传
PUBLISH_CHUNK_THRESHOLD_MB=5.0
# 每块上传的大小（MB）；建议 ≤ 4 以避开常见 nginx 限制
PUBLISH_CHUNK_SIZE_MB=4.0
# 文件后缀与真实 MIME 不一致时（如 .png 实为 webp）的策略：
#   rename = 默认，按真实 MIME 改写后缀后上传
#   skip   = 跳过该文件并打 warning
#   strict = 标记失败（保留旧版严格行为）
PUBLISH_ON_MIME_MISMATCH=rename

# ====== 翻译策略 ======
# 是否把"上次抓到的源 wikitext"和当前源做 diff 后传给 LLM
STRATEGY_USE_SOURCE_DIFF=true
# 是否把仓库里现有译文作为参考喂给 LLM（保留术语与人工润色）
STRATEGY_USE_REPO_REFERENCE=true
# 推送前是否拉取目标 wiki 内容做冲突检测
STRATEGY_FETCH_TARGET_BEFORE_PUBLISH=true
# 源 wikitext 缓存目录（提交进仓库，作为下次 diff 的旧值）
STRATEGY_CACHE_SOURCE_DIR=cache/source
# Diff 级局部翻译：仅重译有变化的段落（默认 false；要求 cache/source 已有旧源 + output 已有旧译）
STRATEGY_DIFF_TRANSLATION=false
# 三阶段流水线：fetch 写新源码、process 读的目录
STRATEGY_INCOMING_DIR=cache/incoming
# 三阶段流水线：fetch 产出、process/upload 消费的清单文件
STRATEGY_MANIFEST_FILE=manifest.json

# ====== 密钥（不要把真实值提交进仓库；GitHub Actions 用 Secrets 注入） ======
# OPENAI_API_KEY=sk-xxx
# FANDOM_BOT_USER=YourAccount@YourBot
# FANDOM_BOT_PASSWORD=xxx
